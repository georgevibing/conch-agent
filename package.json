{
  "name": "conch",
  "private": true,
  "description": "A beautiful web facade for Claude Code running on your own machine.",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "storybook": "pnpm --filter @conch/nacre storybook",
    "build-storybook": "pnpm --filter @conch/nacre build-storybook",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && turbo run lint typecheck test",
    "a11y": "node scripts/a11y-sweep.mjs",
    "start": "pnpm --filter @conch/web build && pnpm --filter @conch/server start",
    "dev:mock": "CONCH_ENGINE=mock turbo run dev"
  },
  "devDependencies": {
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "~6.0.3"
  }
}
