{
  "name": "@conch/server",
  "private": true,
  "license": "MIT",
  "description": "Conch gateway — bridges the web app to the local Claude Code install.",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/main.ts",
    "start": "CONCH_OPEN=${CONCH_OPEN:-1} CONCH_SUPERVISE=1 tsx src/start.ts",
    "conch": "tsx src/cli.ts",
    "release": "tsx src/release/cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "eval": "tsx src/evals/run.ts",
    "auto:replay": "tsx src/conversations/replay-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.303",
    "@anthropic-ai/sandbox-runtime": "^0.0.80",
    "@anthropic-ai/sdk": "^0.135.0",
    "@conch/protocol": "workspace:*",
    "@conch/relay": "workspace:*",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@huggingface/transformers": "4.3.1",
    "@matrix-org/matrix-sdk-crypto-wasm": "^18.9.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@peculiar/x509": "^2.2.0",
    "@simplewebauthn/server": "^14.0.3",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "croner": "^10.0.1",
    "cronstrue": "^3.33.0",
    "fake-indexeddb": "^6.2.6",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "fflate": "^0.8.3",
    "google-auth-library": "^11.3.1",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.5.6",
    "jose": "^6.2.12",
    "marked": "18.1.1",
    "nodemailer": "^10.1.7",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "1.64.1",
    "postal-mime": "^4.0.11",
    "reflect-metadata": "0.2.2",
    "sharp": "^0.35.5",
    "tldts": "7.4.18",
    "tsx": "^4.23.15",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@conch/eslint-config": "workspace:*",
    "@conch/tsconfig": "workspace:*",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^9.39.5",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "protobufjs": "7.6.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
