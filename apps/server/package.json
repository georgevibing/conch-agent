{
  "name": "@conch/server",
  "private": true,
  "license": "MIT",
  "description": "Conch gateway — bridges the web app to the local Claude Code install.",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/main.ts",
    "start": "CONCH_OPEN=${CONCH_OPEN:-1} CONCH_SUPERVISE=1 tsx src/start.ts",
    "conch": "tsx src/cli.ts",
    "release": "tsx src/release/cli.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.284",
    "@anthropic-ai/sandbox-runtime": "^0.0.78",
    "@anthropic-ai/sdk": "^0.129.0",
    "@conch/protocol": "workspace:*",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.1",
    "@huggingface/transformers": "4.3.0",
    "@matrix-org/matrix-sdk-crypto-wasm": "^18.9.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@peculiar/x509": "^2.1.0",
    "@simplewebauthn/server": "^14.0.3",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "croner": "^10.0.1",
    "cronstrue": "^3.27.0",
    "fake-indexeddb": "^6.2.5",
    "fastify": "^5.12.5",
    "google-auth-library": "^10.9.1",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.2.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.13",
    "playwright-core": "1.63.0",
    "postal-mime": "^4.0.2",
    "reflect-metadata": "0.2.2",
    "tldts": "7.4.16",
    "tsx": "^4.23.15",
    "uqr": "0.1.3",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@conch/eslint-config": "workspace:*",
    "@conch/tsconfig": "workspace:*",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "eslint": "^9.39.0",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
