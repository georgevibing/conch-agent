# Address the gateway binds to. Loopback only unless CONCH_ALLOW_REMOTE=1
# (or run `pnpm start:network`). Other devices must sign in — set up a password
# in Settings → Security or with `pnpm conch password`. Prefer Tailscale.
CONCH_HOST=127.0.0.1
# Unset, Conch starts on 4317, or the next free port when another program has it.
# Set it only to pin a port: then a port that's taken is reported, never swapped.
# CONCH_PORT=4317
CONCH_ALLOW_REMOTE=0
# Extra hostnames to answer to (comma separated), e.g. a reverse proxy's name.
# Your own Tailscale name is detected automatically.
CONCH_ALLOWED_HOSTS=
# Legacy shared key. Prefer access keys (hashed and revocable): `pnpm conch key`.
# CONCH_TOKEN=
CONCH_LOG_LEVEL=info
# State directory: use the same value for the gateway and the CLI.
# CONCH_HOME=/path/to/private/conch-state
# Built UI override (default: apps/web/dist).
# CONCH_WEB_DIST=/path/to/conch/apps/web/dist
CONCH_OPEN=0
# Reverse proxies must preserve Host/Origin for HTTP and WebSockets.
# Enable access keys before publishing; see docs/REVERSE_PROXY.md.
