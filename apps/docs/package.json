{
  "name": "@conch/docs",
  "private": true,
  "license": "MIT",
  "description": "Conch's documentation: guides in Markdown, reference generated from the code.",
  "type": "module",
  "scripts": {
    "start": "vite --open",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.reference.json && vite build",
    "preview": "vite preview --open",
    "reference": "node --import tsx reference/print.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.reference.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@conch/nacre": "workspace:*",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@conch/eslint-config": "workspace:*",
    "@conch/protocol": "workspace:*",
    "@conch/server": "workspace:*",
    "@conch/tsconfig": "workspace:*",
    "@conch/web": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.0",
    "globals": "^17.12.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  }
}
