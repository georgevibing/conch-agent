{
  "name": "@conch/desktop",
  "private": true,
  "license": "MIT",
  "description": "Conch as an app for macOS, Windows and Linux: a window on the gateway it carries (ADR 0054).",
  "type": "module",
  "main": "dist/main.cjs",
  "conch": {
    "node": "24.21.0"
  },
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "payload": "node scripts/payload.mjs",
    "app:dev": "node scripts/dev.mjs",
    "app:start": "node scripts/start.mjs",
    "dist": "node scripts/dist.mjs",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@conch/eslint-config": "workspace:*",
    "@conch/protocol": "workspace:*",
    "@conch/tsconfig": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  }
}
