{
  "name": "@conch/nacre",
  "version": "0.1.0",
  "private": true,
  "description": "Nacre \u2014 Conch's design language and React component library.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
